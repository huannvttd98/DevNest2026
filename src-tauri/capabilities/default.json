{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (least privilege: app commands are gated in Rust)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    "dialog:allow-open",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "updater:default",
    "process:allow-restart"
  ]
}